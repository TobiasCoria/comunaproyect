<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_donaciones_comuna" model="ir.sequence">
        <field name="name">Donaciones Comuna</field>
        <field name="code">donaciones_comuna.donacion</field>
        <field name="prefix">DON</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="view_donacion_list" model="ir.ui.view">
        <field name="name">donaciones_comuna.donacion.list</field>
        <field name="model">donaciones_comuna.donacion</field>
        <field name="arch" type="xml">
            <list string="Donaciones"
                decoration-success="estado == 'recibida'"
                decoration-danger="estado == 'rechazada'"
                decoration-warning="estado == 'pendiente'">
                <field name="name"/>
                <field name="donante_nombre"/>
                <field name="donante_email"/>
                <field name="tipo"/>
                <field name="monto"/>
                <field name="metodo_pago"/>
                <field name="fecha"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_donacion_form" model="ir.ui.view">
        <field name="name">donaciones_comuna.donacion.form</field>
        <field name="model">donaciones_comuna.donacion</field>
        <field name="arch" type="xml">
            <form string="Donación">
                <header>
                    <button name="action_marcar_recibida"
                        string="Marcar como recibida"
                        type="object"
                        class="btn-primary"
                        invisible="estado != 'pendiente'"/>
                    <button name="action_rechazar"
                        string="Rechazar"
                        type="object"
                        invisible="estado != 'pendiente'"/>
                    <button name="action_generar_recibo"
                        string="Generar recibo"
                        type="object"
                        class="btn-secondary"/>
                    <field name="estado" widget="statusbar"
                        statusbar_visible="pendiente,recibida,rechazada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos del donante">
                            <field name="donante_nombre"/>
                            <field name="donante_email"/>
                            <field name="donante_telefono"/>
                            <field name="donante_dni"/>
                            <field name="vecino_id"/>
                        </group>
                        <group string="Datos de la donación">
                            <field name="tipo"/>
                            <field name="monto" invisible="tipo != 'dinero'"/>
                            <field name="descripcion"/>
                            <field name="destino"/>
                            <field name="fecha"/>
                            <field name="metodo_pago"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pago Mercado Pago"
                            invisible="metodo_pago != 'mercadopago'">
                            <group>
                                <field name="mp_payment_id"/>
                                <field name="mp_status"/>
                            </group>
                        </page>
                        <page string="Notas internas">
                            <field name="notas"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_donacion_search" model="ir.ui.view">
        <field name="name">donaciones_comuna.donacion.search</field>
        <field name="model">donaciones_comuna.donacion</field>
        <field name="arch" type="xml">
            <search string="Buscar donaciones">
                <field name="name" string="Nº Donación"/>
                <field name="donante_nombre" string="Donante"/>
                <field name="donante_email" string="Email"/>
                <filter string="Pendientes" name="pendientes"
                    domain="[('estado','=','pendiente')]"/>
                <filter string="Recibidas" name="recibidas"
                    domain="[('estado','=','recibida')]"/>
                <filter string="Rechazadas" name="rechazadas"
                    domain="[('estado','=','rechazada')]"/>
                <separator/>
                <filter string="Agrupar por tipo" name="group_tipo"
                    context="{'group_by': 'tipo'}"/>
                <filter string="Agrupar por estado" name="group_estado"
                    context="{'group_by': 'estado'}"/>
                <filter string="Agrupar por método de pago" name="group_metodo"
                    context="{'group_by': 'metodo_pago'}"/>
            </search>
        </field>
    </record>

    <record id="action_donacion" model="ir.actions.act_window">
        <field name="name">Donaciones</field>
        <field name="res_model">donaciones_comuna.donacion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_donacion_search"/>
    </record>

    <menuitem id="menu_donaciones_comuna" name="Donaciones Comuna" sequence="40"/>
    <menuitem id="menu_donaciones" name="Donaciones"
        parent="menu_donaciones_comuna"
        action="action_donacion"
        sequence="10"/>

</odoo>