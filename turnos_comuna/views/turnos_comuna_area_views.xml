<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_turnos_comuna_area_list" model="ir.ui.view">
        <field name="name">turnos_comuna.area.list</field>
        <field name="model">turnos_comuna.area</field>
        <field name="arch" type="xml">
            <list string="Áreas de Atención">
                <field name="name"/>
                <field name="horario_atencion"/>
                <field name="duracion_turno"/>
                <field name="turno_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_turnos_comuna_area_form" model="ir.ui.view">
        <field name="name">turnos_comuna.area.form</field>
        <field name="model">turnos_comuna.area</field>
        <field name="arch" type="xml">
            <form string="Área de Atención">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_turnos"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="turno_count" widget="statinfo" string="Turnos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del área..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="duracion_turno"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="horario_atencion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description" placeholder="Descripción del área y servicios que brinda..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_turnos_comuna_area_search" model="ir.ui.view">
        <field name="name">turnos_comuna.area.search</field>
        <field name="model">turnos_comuna.area</field>
        <field name="arch" type="xml">
            <search string="Buscar Áreas">
                <field name="name" string="Área"/>
                <filter string="Activas" name="activas" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="inactivas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_turnos_comuna_area" model="ir.actions.act_window">
        <field name="name">Áreas de Atención</field>
        <field name="res_model">turnos_comuna.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_turnos_comuna_area_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creá el primer área de atención
            </p>
            <p>
                Las áreas agrupan los turnos según el tipo de trámite o servicio.
            </p>
        </field>
    </record>

</odoo>