<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista Productos -->
    <record id="view_tc_product_list" model="ir.ui.view">
        <field name="name">tc.product.list</field>
        <field name="model">tc.product</field>
        <field name="arch" type="xml">
            <list string="Productos">
                <field name="name"/>
                <field name="category_id"/>
                <field name="price"/>
                <field name="stock"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario Productos -->
    <record id="view_tc_product_form" model="ir.ui.view">
        <field name="name">tc.product.form</field>
        <field name="model">tc.product</field>
        <field name="arch" type="xml">
            <form string="Producto">
                <sheet>
                    <field name="image" widget="image"/>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="price"/>
                        <field name="stock"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista Categorías -->
    <record id="view_tc_category_list" model="ir.ui.view">
        <field name="name">tc.product.category.list</field>
        <field name="model">tc.product.category</field>
        <field name="arch" type="xml">
            <list string="Categorías">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario Categorías -->
    <record id="view_tc_category_form" model="ir.ui.view">
        <field name="name">tc.product.category.form</field>
        <field name="model">tc.product.category</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acciones -->
    <record id="action_tc_product" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">tc.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tc_category" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">tc.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_tc_ecommerce" name="TC eCommerce" sequence="10"/>
    <menuitem id="menu_tc_products" name="Productos" parent="menu_tc_ecommerce" action="action_tc_product" sequence="10"/>
    <menuitem id="menu_tc_categories" name="Categorías" parent="menu_tc_ecommerce" action="action_tc_category" sequence="20"/>

    <!-- Vista Lista Pedidos -->
    <record id="view_tc_order_list" model="ir.ui.view">
        <field name="name">tc.order.list</field>
        <field name="model">tc.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="partner_email"/>
                <field name="total"/>
                <field name="state"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario Pedidos -->
    <record id="view_tc_order_form" model="ir.ui.view">
        <field name="name">tc.order.form</field>
        <field name="model">tc.order</field>
        <field name="arch" type="xml">
            <form string="Pedido">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" string="Entregado" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="partner_name"/>
                        <field name="partner_email"/>
                        <field name="partner_phone"/>
                        <field name="partner_address"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción Pedidos -->
    <record id="action_tc_order" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">tc.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú Pedidos -->
    <menuitem id="menu_tc_orders" name="Pedidos" parent="menu_tc_ecommerce" action="action_tc_order" sequence="30"/>

    <!-- Secuencia para pedidos -->
    <record id="seq_tc_order" model="ir.sequence">
        <field name="name">TC Order Sequence</field>
        <field name="code">tc.order</field>
        <field name="prefix">TC/</field>
        <field name="padding">5</field>
    </record>

</odoo>