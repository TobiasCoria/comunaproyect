<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_obras_cuadrilla_list" model="ir.ui.view">
        <field name="name">obras_comuna.cuadrilla.list</field>
        <field name="model">obras_comuna.cuadrilla</field>
        <field name="arch" type="xml">
            <list string="Cuadrillas">
                <field name="name"/>
                <field name="responsable_id"/>
                <field name="cantidad_obras"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <record id="view_obras_cuadrilla_form" model="ir.ui.view">
        <field name="name">obras_comuna.cuadrilla.form</field>
        <field name="model">obras_comuna.cuadrilla</field>
        <field name="arch" type="xml">
            <form string="Cuadrilla">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la cuadrilla"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="responsable_id"/>
                            <field name="activo"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Miembros">
                            <field name="miembro_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Obras asignadas">
                            <field name="obra_ids">
                                <list>
                                    <field name="numero_obra"/>
                                    <field name="name"/>
                                    <field name="estado"/>
                                    <field name="fecha_inicio"/>
                                    <field name="porcentaje_avance"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_obras_cuadrilla" model="ir.actions.act_window">
        <field name="name">Cuadrillas</field>
        <field name="res_model">obras_comuna.cuadrilla</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>