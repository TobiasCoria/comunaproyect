<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pagos_concepto_list" model="ir.ui.view">
        <field name="name">pagos_comuna.concepto.list</field>
        <field name="model">pagos_comuna.concepto</field>
        <field name="arch" type="xml">
            <list string="Conceptos de Pago">
                <field name="name"/>
                <field name="tipo"/>
                <field name="monto_base"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <record id="view_pagos_concepto_form" model="ir.ui.view">
        <field name="name">pagos_comuna.concepto.form</field>
        <field name="model">pagos_comuna.concepto</field>
        <field name="arch" type="xml">
            <form string="Concepto de Pago">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre del concepto"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="monto_base"/>
                            <field name="activo"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pagos_concepto" model="ir.actions.act_window">
        <field name="name">Conceptos</field>
        <field name="res_model">pagos_comuna.concepto</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>