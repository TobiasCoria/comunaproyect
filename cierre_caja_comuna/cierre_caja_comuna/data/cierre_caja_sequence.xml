<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia para Cierre de Caja Diario -->
        <record id="seq_cierre_caja_diario" model="ir.sequence">
            <field name="name">Cierre de Caja Diario</field>
            <field name="code">cierre.caja.diario</field>
            <field name="prefix">CC-%(year)s-</field>
            <field name="suffix"></field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">True</field>
        </record>

        <!-- Secuencia para Movimientos Bancarios -->
        <record id="seq_cierre_caja_movimiento" model="ir.sequence">
            <field name="name">Movimiento Bancario</field>
            <field name="code">cierre.caja.movimiento</field>
            <field name="prefix">MOV-%(year)s-</field>
            <field name="suffix"></field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
