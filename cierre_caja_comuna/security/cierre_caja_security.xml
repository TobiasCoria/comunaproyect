<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_cierre_caja_operador" model="res.groups">
            <field name="name">Caja Municipal / Operador de Caja</field>
        </record>
        <record id="group_cierre_caja_supervisor" model="res.groups">
            <field name="name">Caja Municipal / Supervisor de Caja</field>
            <field name="implied_ids" eval="[(4, ref('group_cierre_caja_operador'))]"/>
        </record>
        <record id="group_cierre_caja_admin" model="res.groups">
            <field name="name">Caja Municipal / Administrador</field>
            <field name="implied_ids" eval="[(4, ref('group_cierre_caja_supervisor'))]"/>
        </record>
    </data>
</odoo>