<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MOVIMIENTOS - FORM VIEW -->
    <record id="view_movimiento_bancario_form" model="ir.ui.view">
        <field name="name">cierre.caja.movimiento.form</field>
        <field name="model">cierre.caja.movimiento</field>
        <field name="arch" type="xml">
            <form string="Movimiento Bancario">
                <header>
                    <button name="action_confirmar" string="Confirmar"
                            type="object" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_cancelar" string="Cancelar"
                            type="object"
                            invisible="state != 'borrador'"
                            confirm="¿Cancelar este movimiento?"/>
                    <button name="action_borrador" string="Volver a Borrador"
                            type="object"
                            invisible="state != 'cancelado'"
                            groups="cierre_caja_comuna.group_cierre_caja_supervisor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos del Movimiento">
                            <field name="fecha" readonly="state == 'confirmado'"/>
                            <field name="cuenta_id" readonly="state == 'confirmado'"/>
                            <field name="tipo_movimiento_id" readonly="state == 'confirmado'"/>
                            <field name="tipo_operacion" readonly="1" widget="badge"
                                   decoration-success="tipo_operacion == 'ingreso'"
                                   decoration-danger="tipo_operacion == 'egreso'"
                                   decoration-info="tipo_operacion == 'transferencia'"/>
                            <field name="cuenta_destino_id"
                                   readonly="state == 'confirmado'"
                                   invisible="tipo_operacion != 'transferencia'"/>
                        </group>
                        <group string="Importe y Comprobante">
                            <field name="monto" readonly="state == 'confirmado'"/>
                            <field name="moneda_id" readonly="1" groups="base.group_multi_currency"/>
                            <field name="numero_comprobante" readonly="state == 'confirmado'"/>
                            <field name="responsable_id" readonly="state == 'confirmado'"/>
                        </group>
                    </group>
                    <group>
                        <field name="concepto" readonly="state == 'confirmado'"
                               placeholder="Descripción detallada del movimiento..."/>
                    </group>
                    <group string="Observaciones">
                        <field name="observaciones" nolabel="1"
                               readonly="state == 'confirmado'"
                               placeholder="Observaciones adicionales..."/>
                    </group>
                    <group string="Documentos">
                        <field name="adjunto_ids" widget="many2many_binary"
                               readonly="state == 'confirmado'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- MOVIMIENTOS - LIST VIEW -->
    <record id="view_movimiento_bancario_list" model="ir.ui.view">
        <field name="name">cierre.caja.movimiento.list</field>
        <field name="model">cierre.caja.movimiento</field>
        <field name="arch" type="xml">
            <list string="Movimientos Bancarios"
                   decoration-success="tipo_operacion == 'ingreso' and state == 'confirmado'"
                   decoration-danger="tipo_operacion == 'egreso' and state == 'confirmado'"
                   decoration-info="tipo_operacion == 'transferencia'"
                   decoration-muted="state == 'cancelado'">
                <field name="name"/>
                <field name="fecha"/>
                <field name="cierre_id" optional="show"/>
                <field name="cuenta_id"/>
                <field name="tipo_movimiento_id"/>
                <field name="tipo_operacion" widget="badge"
                       decoration-success="tipo_operacion == 'ingreso'"
                       decoration-danger="tipo_operacion == 'egreso'"
                       decoration-info="tipo_operacion == 'transferencia'"/>
                <field name="concepto"/>
                <field name="numero_comprobante" optional="show"/>
                <field name="monto" sum="Total"/>
                <field name="responsable_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmado'"
                       decoration-warning="state == 'borrador'"
                       decoration-danger="state == 'cancelado'"/>
            </list>
        </field>
    </record>

    <!-- MOVIMIENTOS - SEARCH VIEW -->
    <record id="view_movimiento_bancario_search" model="ir.ui.view">
        <field name="name">cierre.caja.movimiento.search</field>
        <field name="model">cierre.caja.movimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar Movimientos">
                <field name="name" string="Referencia"/>
                <field name="concepto" string="Concepto"/>
                <field name="cuenta_id" string="Cuenta"/>
                <field name="tipo_movimiento_id" string="Tipo"/>
                <field name="responsable_id" string="Responsable"/>
                <field name="numero_comprobante" string="N° Comprobante"/>

                <filter string="Hoy" name="hoy"
                        domain="[('fecha','=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Ingresos" name="ingresos" domain="[('tipo_operacion','=','ingreso')]"/>
                <filter string="Egresos" name="egresos" domain="[('tipo_operacion','=','egreso')]"/>
                <filter string="Transferencias" name="transf" domain="[('tipo_operacion','=','transferencia')]"/>
                <separator/>
                <filter string="Confirmados" name="confirmado" domain="[('state','=','confirmado')]"/>
                <filter string="Borrador" name="borrador" domain="[('state','=','borrador')]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Cuenta" name="group_cuenta" context="{'group_by': 'cuenta_id'}"/>
                    <filter string="Tipo de Movimiento" name="group_tipo" context="{'group_by': 'tipo_movimiento_id'}"/>
                    <filter string="Responsable" name="group_resp" context="{'group_by': 'responsable_id'}"/>
                    <filter string="Día" name="group_dia" context="{'group_by': 'fecha:day'}"/>
                    <filter string="Mes" name="group_mes" context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION: Todos los movimientos -->
    <record id="action_movimiento_bancario" model="ir.actions.act_window">
        <field name="name">Movimientos Bancarios</field>
        <field name="res_model">cierre.caja.movimiento</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_movimiento_bancario_search"/>
        <field name="context">{'search_default_hoy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay movimientos registrados.
            </p>
            <p>Registre los movimientos bancarios del día.</p>
        </field>
    </record>

</odoo>
